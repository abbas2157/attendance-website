# Serve only static assets — no PHP execution allowed.
Options -Indexes

# Deny PHP execution in assets directory
<FilesMatch "\.php[s345]?$">
  Require all denied
</FilesMatch>

# Cache static assets aggressively
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 year"
</IfModule>
